<config>
  <constants
    cache_path="data/Cache"
    factor_root="data/Factor/FactorData"
    output_root="output-torch"
    checkpoint_root=""
  />

  <strategy
    start_ds="20160111"
    end_ds="20200101"
  />

  <combo>
    <paths
      base_dir="../vendor/comb2"
      output_dir="output-torch"
      model_path="model.py"
      research_loader_path="loader.py"
      research_dataset_path="dataset.py"
      checkpoint_root=""
    />

    <output
      alpha_history_path="output-torch/alpha_history.pt"
      log_path="output-torch/train.log"
      enable_alpha_analysis="true"
    />

    <runtime
      snaptime="mlp_minimal"
      livetrading="false"
      trainDelay="1"
      retDays="1"
      tsDays="8"
      load_chunk_days=""
      processed_feature_cache="false"
      model_smooth_rate="0.7"
      model_keep_num="2"
      select_days="100"
      max_train_days="2000"
      verbose="false"
    />

    <model
      device="cpu"
      hiddenSize="512"
      fcSize="256"
      dropout="0.5"
      lr="0.000002"
      epochs="15"
      batchSize="3"
      weight_decay="0.000001"
      scheduler_step_size="10"
      scheduler_gamma="0.5"
      grad_clip="10.0"
      seed="42"
    />

    <data
      dtype="float16"
      compression="none"
      data_start_ds="20160101"
      label_path=""
      ashare_data_path=""
      valid_path=""
      filtered_path=""
      base_universe_path=""
    >
      <!--
      Optional data declaration examples:

      <import preset="barra" />

      <item name="alpha.example" module="builtin.factor" path="alpha1_20251008_01" role="factor">
        <op name="neut(size, btop)" />
        <op name="cs_zscore" />
      </item>

      <item name="label.default" module="builtin.label" path="label1d" role="label" />
      -->
    </data>

    <loader
      dtype="float16"
      compression="none"
      data_start_ds="20160101"
      label_path=""
      ashare_data_path=""
      valid_path=""
      filtered_path=""
      base_universe_path=""
    >
      <factor_paths>
        <path>yz_20250219_02</path>
        <path>wjx_20240829_02</path>
        <path>guanxl_05</path>
        <path>alpha1_20251008_01</path>
        <path>alpha2_20251008_02</path>
        <path>alpha3_20251008_03</path>
        <path>alpha4_20251008_04</path>
        <path>alpha5_20251008_05</path>
      </factor_paths>
    </loader>

    <defaults
      selection_module=""
    />
  </combo>

  <backtest
    output_path="output-torch/backtest"
    daily_metrics_file="daily_pnl.csv"
    cash="10000000.0"
    fee_rate="0.0015"
    reserve_cash="0.95"
    verbose="false"
    universe="base"
    execution_price="vwap30"
    drawdown_stop="0.0"
    cooldown_days="0"
  />

  <monitor
    enabled="false"
    output_path=""
    format="csv"
    print_summary="true"
    collect_gpu="true"
    sync_cuda="false"
    verbose="false"
  />
</config>

<optuna_study>
  <!-- study.name：本次实验名称；默认也会作为 optuna_runs 下的输出目录名。 -->
  <!-- study.optuna_name：Optuna sqlite 数据库内部使用的 study 名。 -->
  <!-- study.n_trials：run_study.py 未指定试验次数时，Phase A 默认运行的 trial 数。 -->
  <study
    name="study_torch_model_detailed"
    optuna_name="torch_model"
    n_trials="60"
  />

  <!-- baseline.config_path：普通模式下可直接运行的 comb2 XML；所有 trial config 都从它复制并打补丁。 -->
  <baseline
    config_path="eg-torch/config.xml"
  />

  <!-- windows.tuning_run_start_ds：Phase A/B 实际渲染运行窗口的开始日期；滚动训练的数据起点仍使用 baseline config 里的 loader.data_start_ds。 -->
  <!-- windows.tuning_run_end_ds：Phase A/B 实际渲染运行窗口的结束日期。 -->
  <!-- windows.full_run_start_ds：Baseline 和 Phase C 实际渲染运行窗口的开始日期。 -->
  <!-- windows.full_run_end_ds：Baseline 和 Phase C 实际渲染运行窗口的结束日期。 -->
  <!-- windows.scoring_start_ds：目标函数评分窗口的开始日期；指标从 daily PnL 精确切片计算。 -->
  <!-- windows.scoring_end_ds：目标函数评分窗口的结束日期。 -->
  <windows
    tuning_run_start_ds="20200102"
    tuning_run_end_ds="20231229"
    full_run_start_ds="20200102"
    full_run_end_ds="20240628"
    scoring_start_ds="20210104"
    scoring_end_ds="20231229"
  />

  <!-- fixed_overrides：每次渲染 run config 时都会固定写入的 XML 属性。 不要动这个-->
  <!-- override.path：点分形式的 XML 路径，例如 combo.model.seed 或 combo.output.enable_alpha_analysis。 -->
  <!-- override.value：写入该 XML 属性的固定值。 -->
  <fixed_overrides>
    <override path="combo.output.enable_alpha_analysis" value="false" />
  </fixed_overrides>

  <!-- phase_b.seeds：Phase B 稳定性检查使用的随机种子，逗号分隔。 -->
  <!-- phase_b.candidate_scan_top_n：从 reports/top10.csv 读取前多少行作为候选池，之后再去重。 -->
  <!-- phase_b.candidate_limit：Phase B 最多实际运行多少个去重后的候选参数组。 -->
  <!-- phase_b.sharpe_margin：任一 seed 的评分窗口夏普低于 baseline 夏普减去该值时淘汰。 -->
  <!-- phase_b.dd_multiplier：任一 seed 的评分窗口 dd_li 高于 baseline dd_li 乘以该倍数时淘汰。 -->
  <!-- phase_b.sharpe_std_max：多个 seed 的评分窗口夏普标准差超过该值时淘汰。 -->
  <phase_b
    seeds="42,43,44"
    candidate_scan_top_n="6"
    candidate_limit="3"
    sharpe_margin="0.15"
    dd_multiplier="1.15"
    sharpe_std_max="0.15"
  />

  <!-- phase_c.holdout_years：Phase C 中作为样本外检查的年份，逗号分隔。 -->
  <!-- phase_c.tuning_years：Phase C 中要求相对 baseline 年度夏普有提升的调参年份，逗号分隔。 -->
  <!-- phase_c.holdout_sharpe_margin：holdout 年份夏普低于 baseline 夏普减去该值时淘汰。 -->
  <!-- phase_c.full_dd_multiplier：全窗口 dd_li 高于 baseline 全窗口 dd_li 乘以该倍数时淘汰。 -->
  <!-- phase_c.min_tuning_years_better：每个 seed 至少需要多少个 tuning_years 的年度夏普超过 baseline。 -->
  <!-- phase_c.full_sharpe_std_max：多个 seed 的全窗口夏普标准差大于等于该值时淘汰。 -->
  <phase_c
    holdout_years="2020,2024"
    tuning_years="2021,2022,2023"
    holdout_sharpe_margin="0.3"
    full_dd_multiplier="1.3"
    min_tuning_years_better="2"
    full_sharpe_std_max="0.25"
  />

  <!-- search_space：声明要调参的字段；非虚拟参数必须存在于 baseline 的 combo.model 或 combo.runtime 中。 -->
  <!-- param.section：参数所在 XML 区域，取 model 或 runtime；仅 target="none" 的虚拟参数可以省略。 -->
  <!-- param.name：Optuna 参数名；对非虚拟参数也等于 baseline XML 里的属性名。 -->
  <!-- param.type：参数类型，可选 float、int、categorical。 -->
  <!-- param.low / param.high：float 或 int 参数的搜索上下界。 -->
  <!-- param.step：int 参数的可选步长。 -->
  <!-- param.log：是否使用对数尺度搜索，适用于 float 或 int。 -->
  <!-- param.choices：categorical 参数的候选值，逗号分隔。 -->
  <!-- param.baseline：显式指定 baseline 值；虚拟参数必须填写。 -->
  <!-- param.target：虚拟参数使用 target="none"，表示该参数不会直接写入 XML。 -->
  <search_space>
    <param section="model" name="lr" type="float" low="1e-7" high="1e-4" log="true" />
    <param section="model" name="weight_decay" type="float" low="1e-8" high="1e-3" log="true" />
    <param section="model" name="dropout" type="float" low="0.2" high="0.6" />
    <param section="model" name="hiddenSize" type="categorical" choices="64,128,256,512,768" />
    <param section="model" name="fcSize" type="categorical" choices="64,128,256,512" />
    <param section="model" name="batchSize" type="int" low="2" high="8" />
    <param section="model" name="epochs" type="int" low="8" high="30" />
    <param section="model" name="scheduler_step_size" type="int" low="5" high="20" />
    <param section="model" name="scheduler_gamma" type="float" low="0.3" high="0.9" />
    <param section="model" name="grad_clip" type="float" low="1.0" high="20.0" />
  </search_space>

</optuna_study>
